[submodule "lib/micropython"]
	path = lib/micropython
	url = https://github.com/micropython/micropython.git
	branch = master
[submodule "lib/lvgl"]
	path = lib/lvgl
	url = https://github.com/lvgl/lvgl.git
	branch = release/v8.3
[submodule "lib/lv_bindings"]
	path = lib/lv_bindings
	url = https://github.com/lvgl/lv_binding_micropython.git
	branch = master
[submodule "lib/pycparser"]
	path = lib/pycparser
	url = https://github.com/eliben/pycparser.git
	branch = master
[submodule "lib/ulab"]
	path = lib/ulab
	url = https://github.com/v923z/micropython-ulab.git
	branch = master
